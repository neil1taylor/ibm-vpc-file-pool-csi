{
  "name": "ibm-vpc-file-pool-csi-console-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "OpenShift Console plugin for IBM VPC File Pool CSI Driver",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && NODE_ENV=production yarn ts-node ./node_modules/.bin/webpack",
    "dev": "yarn ts-node ./node_modules/.bin/webpack serve",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "start-console": "./start-console.sh"
  },
  "consolePlugin": {
    "name": "ibm-vpc-file-pool-csi",
    "version": "0.1.0",
    "displayName": "IBM VPC File Pool CSI",
    "description": "Manage VPC File Share Pools, SubVolumes, Snapshots, and Replication from the OpenShift Console",
    "exposedModules": {
      "VPCFilePoolsPage": "./components/VPCFilePoolsPage"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  },
  "dependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.20.0",
    "@patternfly/react-charts": "^7.4.0",
    "@patternfly/react-core": "^6.1.0",
    "@patternfly/react-icons": "^6.1.0",
    "@patternfly/react-table": "^6.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^5.3.4"
  },
  "resolutions": {
    "@types/react": "^18.2.0"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.20.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-helmet": "^6.1.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "copy-webpack-plugin": "^12.0.0",
    "css-loader": "^6.9.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "style-loader": "^3.3.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  }
}
