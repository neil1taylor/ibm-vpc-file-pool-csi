                    "cpu": "2",
                    "memory": "2Gi"
                  },
                  "requests": {
                    "cpu": "200m",
                    "memory": "512Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "mountPath": "/var/run/pool-csi/backup-key-wrapped",
                    "name": "backup-key-wrapped",
                    "readOnly": true
                  },
                  {
                    "mountPath": "/var/run/pool-csi/keyprotect-apikey",
                    "name": "keyprotect-apikey",
                    "readOnly": true
                  },
