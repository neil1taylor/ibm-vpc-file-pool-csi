            "securityContext": {
              "runAsUser": 0
            },
            "volumes": [
              {
                "name": "backup-key-wrapped",
                "secret": {
                  "items": [
                    {
                      "key": "wrappedKey",
                      "path": "wrappedKey"
                    }
                  ],
                  "secretName": "cos-backup-key"
                }
              },
              {
                "name": "keyprotect-apikey",
                "secret": {
                  "items": [
                    {
                      "key": "apikey",
                      "path": "apikey"
                    }
                  ],
                  "secretName": "keyprotect-apikey"
                }
              },
              {
                "emptyDir": {
                  "medium": "Memory",
                  "sizeLimit": "1Mi"
                },
                "name": "backup-key-memory"
              }
            ]
          }
        }
